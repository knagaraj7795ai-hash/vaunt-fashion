{
  "outputDirectory": "dist",
  "buildCommand": "npx expo export --platform web",
  "installCommand": "npm install",
  "framework": "vite",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/((?!assets/|_expo/).*)", "destination": "/index.html" }
  ]
}
